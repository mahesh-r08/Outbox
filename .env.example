# ─────────────────────────────────────────────────
# ReachInbox Email Scheduler — Environment Config
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ── Database & Cache ──────────────────────────────
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379

# ── Authentication & Sessions ─────────────────────
# Minimum 32 characters. Change this to a secure random string in production.
SESSION_SECRET=change_this_to_a_random_32_char_minimum_secret_key

# Set to true when serving over HTTPS in production
COOKIE_SECURE=false

# AES-256-GCM key for SMTP credential encryption at rest.
# Change this to a secure random string in production. Keep secret.
ENCRYPTION_KEY=change_this_to_a_random_32_char_minimum_encryption_key

# ── Google OAuth 2.0 ──────────────────────────────
# Required. Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Ethereal SMTP (Test Provider) ────────────────
# Optional: leave empty to auto-provision a free test account on first sender creation.
# Real accounts: https://ethereal.email
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# ── BullMQ Worker & Rate Limiting ────────────────
# Number of concurrent email processing jobs per worker process
WORKER_CONCURRENCY=5

# Minimum milliseconds between emails sent from the same sender (distributed, Redis-backed)
MIN_EMAIL_DELAY_MS=2000

# Maximum emails per hour per sender (distributed, Redis atomic counter)
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=200
