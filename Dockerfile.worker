# ── ReachInbox Worker Dockerfile ──────────────────────────
FROM node:22-alpine AS base
RUN apk add --no-cache openssl
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
RUN npm ci --workspace=backend --ignore-scripts \
	&& mkdir -p backend/node_modules \
	&& cp -R node_modules backend/node_modules || true

FROM deps AS build
COPY backend/ ./backend/
COPY backend/prisma/ ./backend/prisma/
RUN cd backend && npx prisma generate
RUN cd backend && npx tsc -p tsconfig.json

FROM node:22-alpine AS production
RUN apk add --no-cache openssl
ENV NODE_ENV=production
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/backend/node_modules ./backend/node_modules
COPY --from=build /app/backend/dist ./backend/dist
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/.prisma ./backend/node_modules/.prisma
COPY backend/prisma/ ./backend/prisma/
COPY backend/package.json ./backend/

CMD ["node", "backend/dist/src/workers/index.js"]
