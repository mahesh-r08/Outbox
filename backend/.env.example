# Application Environment Configuration
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database & Cache (Docker Compose defaults)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379

# Authentication & Sessions
SESSION_SECRET=reachinbox_super_secret_session_key_change_in_production_32chars
COOKIE_SECURE=false

# Google OAuth 2.0 (Required for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Default Ethereal SMTP Provider (Optional / Auto-provisioned per sender if blank)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# BullMQ Worker & Rate Limiting Controls
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
